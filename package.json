{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@seoyunnie/portfolio-website",
  "version": "0.0.0",
  "private": true,
  "homepage": "https://seoyunnie.github.io",
  "license": "MIT",
  "author": "Seoyun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seoyunnie/seoyunnie.github.io.git"
  },
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "fmt": "oxfmt",
    "fmt:check": "pnpm run fmt --check",
    "lint": "pnpm run lint:js && pnpm run lint:css",
    "lint:css": "stylelint \"**/*.css\" --cache",
    "lint:css:fix": "pnpm run lint:css --fix",
    "lint:fix": "pnpm run lint:js:fix && pnpm run lint:css:fix",
    "lint:js": "oxlint",
    "lint:js:fix": "pnpm run lint:js --fix",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/roboto": "^5.3.0",
    "@fontsource/fusion-pixel-10px-proportional-kr": "^5.3.0",
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@mantine/core": "^9.6.3",
    "@mantine/hooks": "^9.6.3",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-router": "^1.170.40",
    "@tanstack/react-router-devtools": "^1.167.2",
    "clsx": "^2.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@seoyunnie/oxc-config": "^1.6.0",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@tanstack/router-plugin": "^1.168.41",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint-plugin-perfectionist": "^5.12.1",
    "oxc-transform-react": "^0.152.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "postcss": "^8.5.28",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "sharp": "^0.35.5",
    "stylelint": "^17.15.0",
    "stylelint-config-css-modules": "^4.6.0",
    "stylelint-config-standard": "^40.0.0",
    "svgo": "^4.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-image-optimizer": "^2.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.8.2",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "^24.11.1",
      "onFail": "error"
    }
  }
}
